TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

# worker <-> backend
INTERNAL_TOKEN=change-me

# web authentication (change the development defaults before deployment)
AUTH_ENABLED=true
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=admin1234
AUTH_VIEWER_LOGIN=viewer
AUTH_VIEWER_PASSWORD=viewer1234
AUTH_SESSION_TTL_HOURS=12

# откуда sync_models берет best.onnx
TRAIN_RUNS_DIR=training/runs

# датасеты (merged/<модель>/images|labels) лежат вне репы
MERGED_DIR=

# логин jupyter на стенде linq, нужен для worker.detector: linq (программы лежат в /auto/cache/<логин>)
LINQ_LOGIN=


BACKEND_PORT=8000
FRONTEND_PORT=5173
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

WEBRTC_HOST=127.0.0.1

# секрет в имя очереди моста, брокер на стенде общий
BRIDGE_PREFIX=

# воркер на стенде: ролик в ui отстаёт на столько сек, рамки ждут столько же
SYNC_LAG_S=0

# кадров в секунду на камеру для ppe; закомментировано — берётся worker.ppe_fps из config.yaml
# PPE_FPS=4

# адреса, на которых слушают backend и MediaMTX
BACKEND_HOST=127.0.0.1
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_HLS_PORT=8888

# как показывать видео в браузере: webrtc или hls
VIDEO_MODE=webrtc

# камеры из файлов: ширина потока (0 — как в исходнике), потолок битрейта (пусто — без ограничения), кодек h264 или vp8
STREAM_WIDTH=0
STREAM_MAXRATE=
STREAM_CODEC=h264
