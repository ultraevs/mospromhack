# Скопируй в .env и заполни. Файл .env в git не входит.

# Токен телеграм-бота. Если пуст, бот выключен, остальное работает.
TELEGRAM_BOT_TOKEN=

# Общий секрет worker <-> backend (заголовок X-Internal-Token).
INTERNAL_TOKEN=change-me

# Папка runs/ из обучения: оттуда sync_models.ps1 копирует best.onnx и model.yaml.
TRAIN_RUNS_DIR=C:\Users\Sehap\Documents\hak\ppe-train\ppe-train\runs

# Порты
BACKEND_PORT=8000
FRONTEND_PORT=5173
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
